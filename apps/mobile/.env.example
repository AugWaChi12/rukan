# ค่าจาก `pnpm db:status` (local) หรือ Supabase Dashboard → Project Settings → API Keys (production)
# ถูกฝังลงในแอป — ใส่ได้เฉพาะ publishable key เท่านั้น ห้ามใส่ secret / service_role key
#
# URL ตอน dev:
# - iOS simulator / Expo web:  http://127.0.0.1:54321
# - Android emulator:          http://10.0.2.2:54321
# - มือถือจริง (Expo Go):        http://<IP เครื่อง dev เช่น 192.168.1.10>:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
