NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://stumatch:stumatch@localhost:5433/stumatch_dev?schema=public
# origin ที่อนุญาตให้เรียก API (คั่นด้วย comma) — 3000 = web, 8081 = Expo web/Metro
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# production: สร้างค่าสุ่มยาวๆ เช่น `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
